# Copy to .env.local (git-ignored). Never commit real values.
# Local development against a fork: see e2e/serve.ts, which sets all of this itself.
# An empty value counts as missing, but the optional lines are commented out so nothing is half-set.

# The passkeys' site and the page's full origin (port included). Fix RP_ID once real accounts exist.
RP_ID=localhost
ORIGIN=http://localhost:3000
# At least 32 characters, random. Generate your own; never reuse one from elsewhere.
SESSION_SECRET=

# Required with CHAIN_MODE=mainnet: Neon's URL. "memory" or "pglite:<folder>" for local development.
DATABASE_URL=pglite:.pglite

CHAIN_MODE=mainnet
CELO_RPC_URL=https://forno.celo.org
BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org

# Optional.
# PIMLICO_API_KEY=
# PIMLICO_SPONSORSHIP_POLICY_ID=
# AGENT_PRIVATE_KEY=
# The deployed agent sends nothing until this is "on".
# AGENT_SEND=off
# HEARTBEAT_SECRET=
# BLOCKSCOUT_API_KEY=
# PUBLIC_FUND=

# The chat (spec, 8.2): off until CHAT_MODEL is set. On Vercel, the AI Gateway authenticates with OIDC.
# CHAT_MODEL=anthropic/claude-sonnet-5.5
# CHAT_MEMBER_DAILY_LIMIT=30
# CHAT_DAILY_LIMIT=150
